# 本地凭据示例：复制为 .env（已被 .gitignore 忽略）后填入真实值。
# 不要提交 .env，也不要把凭据写进文档、issue 或日志。

# Strava 应用凭据，来自 https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# 由 `pnpm strava-auth` 生成并自动写回，Strava 可能在每次刷新时轮换该值
STRAVA_REFRESH_TOKEN=

# 每次同步最多拉取多少条活动详情（calories 只能从详情接口拿到）
STRAVA_MAX_DETAILS=400
