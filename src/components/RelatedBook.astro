---
interface Props {
  title: string
  author: string
  cover: string
  href: string
}

const { title, author, cover, href } = Astro.props
---

<aside class="no-heti mb-13" aria-label="关联书籍">
  <a
    class="group flex items-center gap-3.5 border-y border-secondary/12 border-solid py-3.5 transition-colors hover:border-secondary/30 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-3"
    href={href}
  >
    <img
      class="h-15 w-11 shrink-0 rounded-0.5 object-cover"
      src={cover}
      alt=""
      decoding="async"
      data-no-zoom
    />
    <span class="min-w-0">
      <span class="block text-3 c-secondary">关联书籍</span>
      <strong class="mt-0.5 block truncate c-primary font-medium group-hover:underline">《{title}》</strong>
      <span class="mt-0.25 block truncate text-3.2 c-secondary">{author}</span>
    </span>
  </a>
</aside>
